// --------------------------
// 1️⃣ Import des modules
// --------------------------
import fetch from "node-fetch"; // pour envoyer des requêtes HTTP
import { cosineSimilarity } from "./utils.js"; // fonction pour calculer la similarité cosinus

// --------------------------
// 2️⃣ Définir la clé et l'URL Gemini
// --------------------------
const GEMINI_API_KEY = "TA_CLE_API_ICI"; // 🔑 Remplace par ta clé Gemini
const GEMINI_API_URL = "https://api.gemini.example.com/v1/embeddings"; // Exemple, à adapter

// --------------------------
// 3️⃣ Données exemple
// --------------------------
const mentors = [
  { id: 1, name: "Alice", description: "Expert in React, Node.js, and frontend development." },
  { id: 2, name: "Bob", description: "Data scientist specialized in Python, ML, and AI." },
  { id: 3, name: "Carol", description: "Product manager with experience in Agile and UX design." }
];

// Objectif de l'utilisateur
const userGoal = "I want to learn machine learning and Python programming.";

// --------------------------
// 4️⃣ Fonction pour récupérer l'embedding d'un texte
// --------------------------
async function getEmbedding(text) {
  // On envoie une requête POST à Gemini
  const response = await fetch(GEMINI_API_URL, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${GEMINI_API_KEY}`, // Authentification
      "Content-Type": "application/json"          // On envoie du JSON
    },
    body: JSON.stringify({ text })                // Texte à transformer en vecteur
  });

  const data = await response.json();
  return data.embedding; // Gemini renvoie un vecteur numérique
}

// --------------------------
// 5️⃣ Fonction pour recommander un mentor
// --------------------------
async function recommendMentor(userGoal, mentors) {
  // 5a. On récupère l'embedding de l'objectif utilisateur
  const userEmbedding = await getEmbedding(userGoal);

  let bestMatch = null;
  let highestSimilarity = -1;

  // 5b. Pour chaque mentor, on récupère l'embedding et on calcule la similarité cosinus
  for (let mentor of mentors) {
    const mentorEmbedding = await getEmbedding(mentor.description);
    const similarity = cosineSimilarity(userEmbedding, mentorEmbedding);

    console.log(`Similarity with ${mentor.name}: ${similarity.toFixed(2)}`);

    if (similarity > highestSimilarity) {
      highestSimilarity = similarity;
      bestMatch = mentor;
    }
  }

  return bestMatch;
}

// --------------------------
// 6️⃣ Exécution
// --------------------------
(async () => {
  const recommended = await recommendMentor(userGoal, mentors);
  console.log("\n✅ Recommended mentor:", recommended.name);
})();
